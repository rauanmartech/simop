# ==============================================================================
# SISTEMA DE MUSEUS DE OURO PRETO (SIMOP) - VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Copie este arquivo para .env.local e preencha as variáveis conforme necessário.
#
# NOTA: O projeto possui fallbacks automáticos para visualização estática quando
# as variáveis abaixo não estiverem configuradas.

# ------------------------------------------------------------------------------
# Supabase Configuration (Opcional - caso utilize acervo dinâmico ou admin)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ------------------------------------------------------------------------------
# Domínio do Site & Metadados SEO (Opcional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://simopouropreto.com.br
NEXT_PUBLIC_FACEBOOK_APP_ID=1000000000000000

# ------------------------------------------------------------------------------
# Olhar Museu URL (Opcional - link para portal editorial externo)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_OLHAR_MUSEU_URL=https://olharmuseu.simopouropreto.com.br

